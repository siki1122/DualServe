rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // AUTHENTICATION & AUTHORIZATION HELPER FUNCTIONS
    // ============================================================================

    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // ============================================================================
    // USERS COLLECTION
    // ============================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      
      // Users can only create their own document with customer, pending_provider, provider, or driver role
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    request.resource.data.role in ['customer', 'pending_provider', 'provider', 'driver', 'Employee'];
      
      // Users can update their own data BUT CANNOT change their own role 
      // (Except transitioning to provider/pending_provider/driver for verification)
      allow update: if isSignedIn() && (
        request.auth.uid == userId && (
          request.resource.data.role == resource.data.role || 
          request.resource.data.role in ['pending_provider', 'provider', 'driver', 'Employee']
        )
      );
      
      allow delete: if false;
    }

    // ============================================================================
    // EMPLOYEES COLLECTION (formerly DRIVERS)
    // ============================================================================
    match /Employees/{driverId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == driverId;
      allow update: if isSignedIn() && request.auth.uid == driverId;
      allow delete: if false;
    }

    // ============================================================================
    // DRIVER LOCATIONS COLLECTION
    // ============================================================================
    match /driver_locations/{driverId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == driverId;
    }

    // ============================================================================
    // PROVIDERS COLLECTION
    // ============================================================================
    match /providers/{providerId} {
      allow read: if isSignedIn();
      
      // Providers can create their own profile
      allow create: if isSignedIn() && request.auth.uid == providerId;
      
      allow update: if isSignedIn() && (
        (request.auth.uid == providerId && (
          request.resource.data.isApproved == false || 
          request.resource.data.isApproved == resource.data.isApproved
        )) || 
        // Allow customers to update rating and totalReviews when submitting a review
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'totalReviews']))
      );
      
      allow delete: if false;
    }

    // ============================================================================
    // BOOKINGS COLLECTION
    // ============================================================================
    match /bookings/{bookingId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedProviderId == request.auth.uid ||
        (exists(/databases/$(database)/documents/Employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Employees/$(request.auth.uid)).data.providerId == resource.data.assignedProviderId) ||
        // Allow providers to accept a pending booking
        (resource.data.status == 'pending' && request.resource.data.assignedProviderId == request.auth.uid)
      );
      allow delete: if false;
    }

    // ============================================================================
    // PROVIDER SLOTS COLLECTION
    // ============================================================================
    match /provider_slots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow delete: if isSignedIn() && (
        // Either the customer who booked it, or the assigned provider can delete the slot lock
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow update: if false;
    }

    // ============================================================================
    // TASKS COLLECTION
    // ============================================================================
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedProviderId == request.auth.uid ||
        resource.data.assignedDriverId == request.auth.uid ||
        (exists(/databases/$(database)/documents/Employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Employees/$(request.auth.uid)).data.providerId == resource.data.assignedProviderId)
      );
      allow create: if isSignedIn() && request.resource.data.assignedProviderId == request.auth.uid;
      allow delete: if false;
    }

    // ============================================================================
    // ASSETS COLLECTION
    // ============================================================================
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (request.resource.data.assignedTo == request.auth.uid || 
         request.resource.data.ownerId == request.auth.uid || 
         assetId == request.auth.uid) &&
        request.resource.data.status in ['active', 'inUse'] &&
        request.resource.data.type in ['vehicle', 'tool', 'equipment', 'crew'];
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'assignedTo',
          'providerName',
          'status',
          'jobsCompleted',
          'quantity',
          'currentTaskId',
          'currentTaskLabel'
        ]) &&
        (
          // Allow picking up an asset (setting to inUse and setting task fields)
          (
            resource.data.status == 'active' &&
            request.resource.data.status == 'inUse'
          ) ||
          // Allow returning an asset (setting back to active and clearing task fields)
          (
            request.resource.data.status == 'active'
          ) ||
          // Allow incrementing jobs completed and updating task info
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobsCompleted', 'status', 'currentTaskId', 'currentTaskLabel', 'quantity'])
          ) ||
          // Allow returning quantity (for tools/consumables)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'status'])
          )
        );
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.assignedTo == request.auth.uid);
    }

    // ============================================================================
    // ASSET USAGE COLLECTION
    // ============================================================================
    match /asset_usage/{usageId} {
      allow read: if isSignedIn() && resource.data.providerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ============================================================================
    // REVIEWS COLLECTION
    // ============================================================================
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow delete: if false;
    }

    // ============================================================================
    // TRANSACTIONS COLLECTION
    // ============================================================================
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/Employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Employees/$(request.auth.uid)).data.providerId == resource.data.providerId)
      );
      allow create: if isSignedIn() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.providerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/Employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Employees/$(request.auth.uid)).data.providerId == request.resource.data.providerId)
      );
      allow update: if isSignedIn() && (
        resource.data.providerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/Employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Employees/$(request.auth.uid)).data.providerId == resource.data.providerId)
      );
      allow delete: if false;
    }

    // ============================================================================
    // MESSAGES COLLECTION
    // ============================================================================
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // ============================================================================
    // NOTIFICATIONS COLLECTION
    // ============================================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ============================================================================
    // PROVIDER PRICING COLLECTION
    // ============================================================================
    match /provider_pricing/{providerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == providerId;
    }
  }
}
