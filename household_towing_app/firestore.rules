rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // AUTHENTICATION & AUTHORIZATION HELPER FUNCTIONS
    // ============================================================================

    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is an admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email.lower() == 'charleskalvinvalenzuela@gmail.com'
      );
    }

    // (Unused validation functions removed to resolve warnings)


    // ============================================================================
    // USERS COLLECTION
    // ============================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      
      // Users can only create their own document with customer or pending_provider role
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    request.resource.data.role in ['customer', 'pending_provider'];
      
      // Users can update their own data BUT CANNOT change their own role
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) || 
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // ============================================================================
    // PROVIDERS COLLECTION
    // ============================================================================
    match /providers/{providerId} {
      allow read: if isSignedIn();
      
      // Providers can create their own profile BUT MUST be unapproved
      allow create: if isSignedIn() && request.auth.uid == providerId && 
                    request.resource.data.isApproved == false;
      
      // Only admins can change isApproved from false to true
      allow update: if isSignedIn() && (
        (request.auth.uid == providerId && request.resource.data.isApproved == resource.data.isApproved) || 
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    // ============================================================================
    // BOOKINGS COLLECTION
    // ============================================================================
    match /bookings/{bookingId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedProviderId == request.auth.uid ||
        isAdmin() ||
        // Allow providers to accept a pending booking
        (resource.data.status == 'pending' && request.resource.data.assignedProviderId == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // ============================================================================
    // TASKS COLLECTION
    // ============================================================================
    match /tasks/{taskId} {
      allow read, update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.assignedProviderId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.assignedProviderId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================================================
    // ASSETS COLLECTION
    // ============================================================================
    match /assets/{assetId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'name',
          'category',
          'type',
          'status',
          'plateNumber',
          'assignedTo',
          'providerName',
          'lastMaintenance',
          'nextMaintenance',
          'jobsCompleted',
          'metadata',
          'quantity'
        ]) &&
        request.resource.data.keys().hasAll([
          'name',
          'category',
          'type',
          'status',
          'assignedTo',
          'providerName',
          'jobsCompleted',
          'metadata',
          'quantity'
        ]) &&
        request.resource.data.assignedTo == request.auth.uid &&
        request.resource.data.status == 'inUse' &&
        request.resource.data.type in ['vehicle', 'tool', 'equipment'] &&
        request.resource.data.name is string &&
        request.resource.data.category is string &&
        request.resource.data.providerName is string &&
        request.resource.data.jobsCompleted == 0
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'assignedTo',
          'providerName',
          'status',
          'jobsCompleted',
          'quantity'
        ]) &&
        (
          // Allow picking up an asset
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'assignedTo',
              'providerName',
              'status'
            ]) &&
            resource.data.status == 'active' &&
            resource.data.get('assignedTo', null) == null &&
            request.resource.data.assignedTo == request.auth.uid &&
            request.resource.data.status == 'inUse'
          ) ||
          // Allow returning an asset (setting to active/null)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'assignedTo',
              'providerName',
              'status'
            ]) &&
            resource.data.assignedTo == request.auth.uid &&
            request.resource.data.assignedTo == null &&
            request.resource.data.providerName == null &&
            request.resource.data.status == 'active'
          ) ||
          // Allow incrementing jobs completed
          (
            resource.data.assignedTo == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'jobsCompleted'
            ]) &&
            request.resource.data.jobsCompleted ==
              resource.data.get('jobsCompleted', 0) + 1
          ) ||
          // Allow returning quantity (for tools/consumables)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'quantity'
            ]) &&
            request.resource.data.quantity > resource.data.quantity
          )
        )
      );
      allow delete: if isAdmin();
    }

    // ============================================================================
    // ASSET USAGE COLLECTION
    // ============================================================================
    match /asset_usage/{usageId} {
      allow read: if isSignedIn() && (
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.providerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ============================================================================
    // REVIEWS COLLECTION
    // ============================================================================
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ============================================================================
    // TRANSACTIONS COLLECTION
    // ============================================================================
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================================================
    // MESSAGES COLLECTION
    // ============================================================================
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ============================================================================
    // PROVIDER PRICING COLLECTION
    // ============================================================================
    match /provider_pricing/{providerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == providerId);
    }
  }
}
